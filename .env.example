# Copy to .env for local runs.
#
# Used by the pipeline (data-preparer) to fetch state court HTML from your WebScraper service.
WEBSCRAPER_URL=
WEBSCRAPER_AUTH=

# OpenSearch connection (recommended when running the pipeline via docker compose)
OPENSEARCH_HOST=opensearch-node1
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=ComplexPassword123!

# Optional: override the URL that MCP servers embed into results.
# STATIC_SERVER_EXTERNAL_URL=http://localhost:8003
